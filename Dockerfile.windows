FROM mcr.microsoft.com/windows/servercore:ltsc2022

ADD https://nodejs.org/dist/v18.19.0/node-v18.19.0-win-x64.zip C:\node.zip

RUN powershell -Command "Expand-Archive C:\node.zip -DestinationPath C:\node; Remove-Item C:\node.zip"

RUN setx PATH "%PATH%;C:\node\node-v18.19.0-win-x64"

WORKDIR /app

COPY . .

RUN powershell -Command "npm install"

EXPOSE 3000

CMD ["node", "server.js"]
